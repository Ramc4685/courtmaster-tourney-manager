{
  "name": "courtmaster-tournament-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:migrate": "node appwrite-migration/setup_collections.js",
    "seed:complete": "node scripts/seed-complete.js",
    "seed:help": "node scripts/seed-complete.js help",
    "generate-icons": "node scripts/generate-pwa-icons.js",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:all": "rm -rf dist node_modules coverage .nyc_output",
    "reinstall": "npm run clean:all && npm install",
    "serve:dist": "npx serve dist -l 3000",
    "health:check": "curl -f http://localhost:3000/health || exit 1",
    "start:dev": "bash scripts/start-development.sh",
    "start:prod": "bash scripts/start-production.sh",
    "stop": "bash scripts/stop-services.sh",
    "docker:build": "docker build -t courtmaster:latest .",
    "docker:build:prod": "docker build --target production -t courtmaster:production .",
    "docker:up": "docker-compose up -d",
    "docker:up:dev": "ENV=development docker-compose up -d",
    "docker:up:prod": "ENV=production docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart"
  },
