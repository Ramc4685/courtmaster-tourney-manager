# CourtMaster Production Environment Template
# Copy this to .env.production and customize with your production values
# DO NOT commit .env.production to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
APP_NAME=CourtMaster Tournament Manager
APP_VERSION=1.0.0

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000

# Production: Disable auth bypass
VITE_BYPASS_AUTH=false

# Offline and PWA settings
VITE_OFFLINE_MODE=true
VITE_SYNC_INTERVAL=60000

# State management
USE_ZUSTAND=false

# =============================================================================
# APPWRITE CONFIGURATION (Cloud Production)
# =============================================================================
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Production project (create separate Appwrite project for production)
VITE_APPWRITE_PROJECT_ID=your-production-project-id
APPWRITE_PROJECT_ID=your-production-project-id
VITE_APPWRITE_PROJECT_NAME=CourtMaster

VITE_APPWRITE_DATABASE_ID=your-production-database-id
APPWRITE_DATABASE_ID=your-production-database-id

# Production API key (set via Docker secrets in production)
APPWRITE_API_KEY=will-be-overridden-by-docker-secrets

# Collection IDs (same as development if using same schema)
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
VITE_APPWRITE_TOURNAMENTS_COLLECTION_ID=tournaments
VITE_APPWRITE_DIVISIONS_COLLECTION_ID=divisions
VITE_APPWRITE_TEAMS_COLLECTION_ID=teams
VITE_APPWRITE_TEAM_MEMBERS_COLLECTION_ID=team_members
VITE_APPWRITE_REGISTRATIONS_COLLECTION_ID=registrations
VITE_APPWRITE_MATCHES_COLLECTION_ID=matches
VITE_APPWRITE_COURTS_COLLECTION_ID=courts
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=notifications

# =============================================================================
# WORKER SERVICE CONFIGURATION
# =============================================================================
VITE_WORKER_URL=https://yourdomain.com/api/worker
WORKER_PORT=3001

# Production Redis (set password via Docker secrets)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=will-be-overridden-by-docker-secrets

# Worker settings (more conservative in production)
SYNC_INTERVAL=60000
CONFLICT_RESOLUTION_STRATEGY=last_write_wins
MAX_RETRY_ATTEMPTS=5
NOTIFICATION_ENABLED=true

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
COMPOSE_PROJECT_NAME=courtmaster-prod
DOCKER_NETWORK=courtmaster-prod-network

# =============================================================================
# PRODUCTION-SPECIFIC SETTINGS
# =============================================================================
# SSL/TLS
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem

# Security
CORS_ORIGIN=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Performance
REDIS_MAX_MEMORY=512mb
WORKER_CONCURRENCY=4

# Docker secrets directory
DOCKER_SECRETS_DIR=/run/secrets