# CourtMaster Tournament Manager - Environment Configuration Template
# Copy this file to .env.development or .env.production and customize values
# DO NOT commit .env files with real secrets to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
APP_NAME=CourtMaster Tournament Manager
APP_VERSION=1.0.0

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Vite development server settings
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000

# Authentication settings
VITE_BYPASS_AUTH=false

# Offline and PWA settings
VITE_OFFLINE_MODE=true
VITE_SYNC_INTERVAL=30000

# State management (true = Zustand, false = Context API)
USE_ZUSTAND=false

# =============================================================================
# APPWRITE CONFIGURATION (Cloud-only)
# =============================================================================
# Cloud Appwrite endpoint (always use cloud)
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Project configuration (get from Appwrite console)
VITE_APPWRITE_PROJECT_ID=your-project-id
APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_PROJECT_NAME=CourtMaster

# Database configuration
VITE_APPWRITE_DATABASE_ID=your-database-id
APPWRITE_DATABASE_ID=your-database-id

# API Key for server-side operations (worker)
APPWRITE_API_KEY=your-api-key

# Collection IDs
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
VITE_APPWRITE_TOURNAMENTS_COLLECTION_ID=tournaments
VITE_APPWRITE_DIVISIONS_COLLECTION_ID=divisions
VITE_APPWRITE_TEAMS_COLLECTION_ID=teams
VITE_APPWRITE_TEAM_MEMBERS_COLLECTION_ID=team_members
VITE_APPWRITE_REGISTRATIONS_COLLECTION_ID=registrations
VITE_APPWRITE_MATCHES_COLLECTION_ID=matches
VITE_APPWRITE_COURTS_COLLECTION_ID=courts
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=notifications

# =============================================================================
# WORKER SERVICE CONFIGURATION
# =============================================================================
# Worker service URL
VITE_WORKER_URL=http://localhost:3001
WORKER_PORT=3001

# Redis configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Worker sync settings
SYNC_INTERVAL=30000
CONFLICT_RESOLUTION_STRATEGY=last_write_wins
MAX_RETRY_ATTEMPTS=3

# Notifications
NOTIFICATION_ENABLED=true

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
# Docker compose project name
COMPOSE_PROJECT_NAME=courtmaster

# Docker network
DOCKER_NETWORK=courtmaster-network

# =============================================================================
# PRODUCTION-SPECIFIC SETTINGS
# =============================================================================
# Only used in production environment

# SSL/TLS
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem

# Security
CORS_ORIGIN=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Performance
REDIS_MAX_MEMORY=256mb
WORKER_CONCURRENCY=2

# =============================================================================
# DOCKER SECRETS (Production)
# =============================================================================
# These will be overridden by Docker secrets in production
# Set these as Docker secrets: appwrite_api_key, redis_password
DOCKER_SECRETS_DIR=/run/secrets